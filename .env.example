# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Custom prompt sent to Gemini with the uploaded file
DEFAULT_PROMPT=Please analyze this uploaded document or file in detail. Provide a comprehensive summary, extract all key facts and insights, and answer any evident questions within the document.

# Gemini Model name
GEMINI_MODEL=gemini-3.5-flash-lite

# Port configuration (set to 443 to activate HTTPS with Apache SSL certs)
PORT=3000

# Optional custom SSL directory or file paths (defaults to C:\Users\niduka\AppData\Roaming\Apache24\conf\ssl)
# SSL_DIR=C:\Users\niduka\AppData\Roaming\Apache24\conf\ssl
# SSL_KEY_PATH=C:\Users\niduka\AppData\Roaming\Apache24\conf\ssl\niduka.southeastasia.cloudapp.azure.com-key.pem
# SSL_CERT_PATH=C:\Users\niduka\AppData\Roaming\Apache24\conf\ssl\niduka.southeastasia.cloudapp.azure.com-crt.pem
# SSL_CHAIN_PATH=C:\Users\niduka\AppData\Roaming\Apache24\conf\ssl\niduka.southeastasia.cloudapp.azure.com-chain.pem
