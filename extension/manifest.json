{
  "manifest_version": 3,
  "name": "Page Assistant",
  "version": "1.0.0",
  "description": "Background productivity assistant",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Toggle Assistant (Alt+S)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-stealth": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle Stealth Assistant"
    }
  },
  "options_page": "options.html",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
