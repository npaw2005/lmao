{
  "manifest_version": 3,
  "name": "Page Assistant",
  "version": "1.1.0",
  "description": "Background productivity assistant",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Toggle Assistant (Alt+Q)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-stealth": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Toggle Stealth Assistant"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
